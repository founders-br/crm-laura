# Worker 24/7 do agent-engine (fusão Vendaval) — processo long-running fora do Next.
# Roda TS direto via tsx (sem build): o worker é I/O-bound e o cold start não importa.
# ponytail: imagem single-stage com devDeps (tsx precisa); multi-stage + prune é Fase 4.
FROM node:22-alpine

WORKDIR /app

# Procedência (doutrina de packaging, invariante 2).
LABEL org.opencontainers.image.source="https://github.com/founders-br/crm-laura" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="DeskcommCRM worker"

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
# pnpm fixado na versão do lockfile do repo (pnpm 10 bloquearia build scripts).
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
# O worker executa TypeScript via `tsx`, que fica em devDependencies. Ambientes de
# deploy como o Coolify podem construir com NODE_ENV=production; nesse caso o
# pnpm omite devDependencies por padrão e o container entra em restart loop com
# "Command tsx not found". Forçamos devDependencies nesta imagem porque `tsx` é
# uma dependência de runtime do worker enquanto ele roda TS diretamente.
RUN pnpm install --frozen-lockfile --prod=false

COPY . .

# Healthz do worker (bind 0.0.0.0 dentro do container).
EXPOSE 8787

CMD ["pnpm", "exec", "tsx", "workers/agent-worker/main.ts"]
